{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos-kit.dev/schema/lws0.schema.json",
  "title": "LWS-0: Logos Kit wallet protocol",
  "version": "0.1.0",
  "$defs": {
    "AccountId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
      "description": "Base58-encoded 32-byte LEZ account id"
    },
    "AccountKind": {
      "anyOf": [
        {
          "type": "string",
          "const": "public"
        },
        {
          "type": "string",
          "const": "private"
        }
      ]
    },
    "Base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "ChainId": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
      "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
    },
    "Hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "Hex": {
      "type": "string",
      "pattern": "^0x[0-9a-f]*$"
    },
    "PrivateHandle": {
      "type": "string",
      "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
      "description": "Opaque per-origin private account handle"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "U128": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$",
      "description": "u128 as a decimal string"
    },
    "Capabilities": {
      "type": "object",
      "required": [
        "accountKinds",
        "signTransaction",
        "batch",
        "outcomeVerification",
        "signMessage",
        "signIn",
        "requestFunds"
      ],
      "properties": {
        "accountKinds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "public"
              },
              {
                "type": "string",
                "const": "private"
              }
            ]
          }
        },
        "signTransaction": {
          "type": "boolean"
        },
        "batch": {
          "type": "object",
          "required": ["maxInstructions", "atomic"],
          "properties": {
            "maxInstructions": {
              "type": "integer",
              "minimum": 1
            },
            "atomic": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "supported"
                },
                {
                  "type": "string",
                  "const": "unsupported"
                }
              ]
            }
          }
        },
        "proving": {
          "type": "object",
          "required": ["location"],
          "properties": {
            "location": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "local"
                },
                {
                  "type": "string",
                  "const": "paired"
                },
                {
                  "type": "string",
                  "const": "user-owned"
                },
                {
                  "type": "string",
                  "const": "tee"
                }
              ]
            },
            "typicalSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "outcomeVerification": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "own-account-invariant"
              },
              {
                "type": "string",
                "const": "program-event"
              },
              {
                "type": "string",
                "const": "node"
              }
            ]
          }
        },
        "signMessage": {
          "type": "boolean"
        },
        "signIn": {
          "type": "boolean"
        },
        "requestFunds": {
          "type": "boolean"
        }
      }
    },
    "Capability": {
      "anyOf": [
        {
          "type": "string",
          "const": "accounts"
        },
        {
          "type": "string",
          "const": "read_public"
        },
        {
          "type": "string",
          "const": "read_private"
        },
        {
          "type": "string",
          "const": "propose_tx"
        },
        {
          "type": "string",
          "const": "sign_message"
        },
        {
          "type": "string",
          "const": "request_proof"
        }
      ]
    },
    "ConnectParams": {
      "type": "object",
      "required": ["chains"],
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
            "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
          },
          "minItems": 1
        },
        "accountKinds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "public"
              },
              {
                "type": "string",
                "const": "private"
              }
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "accounts"
              },
              {
                "type": "string",
                "const": "read_public"
              },
              {
                "type": "string",
                "const": "read_private"
              },
              {
                "type": "string",
                "const": "propose_tx"
              },
              {
                "type": "string",
                "const": "sign_message"
              },
              {
                "type": "string",
                "const": "request_proof"
              }
            ]
          }
        },
        "silent": {
          "type": "boolean"
        },
        "signIn": {
          "type": "object",
          "required": ["domain", "uri", "nonce", "issuedAt"],
          "properties": {
            "domain": {
              "type": "string",
              "maxLength": 253
            },
            "statement": {
              "type": "string",
              "maxLength": 512
            },
            "uri": {
              "type": "string",
              "maxLength": 2048
            },
            "nonce": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64
            },
            "issuedAt": {
              "type": "string",
              "format": "date-time"
            },
            "expirationTime": {
              "type": "string",
              "format": "date-time"
            },
            "notBefore": {
              "type": "string",
              "format": "date-time"
            },
            "requestId": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    },
    "Session": {
      "type": "object",
      "required": ["sessionId", "origin", "chains", "accounts", "capabilities"],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "origin": {
          "type": "string"
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
            "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "kind", "chain", "capabilities"],
            "properties": {
              "address": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                    "description": "Base58-encoded 32-byte LEZ account id"
                  },
                  {
                    "type": "string",
                    "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
                    "description": "Opaque per-origin private account handle"
                  }
                ]
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "public"
                  },
                  {
                    "type": "string",
                    "const": "private"
                  }
                ]
              },
              "chain": {
                "type": "string",
                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
                "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
              },
              "publicKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              },
              "label": {
                "type": "string",
                "maxLength": 64
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "accounts"
                    },
                    {
                      "type": "string",
                      "const": "read_public"
                    },
                    {
                      "type": "string",
                      "const": "read_private"
                    },
                    {
                      "type": "string",
                      "const": "propose_tx"
                    },
                    {
                      "type": "string",
                      "const": "sign_message"
                    },
                    {
                      "type": "string",
                      "const": "request_proof"
                    }
                  ]
                }
              }
            }
          }
        },
        "expiry": {
          "type": "string",
          "format": "date-time"
        },
        "capabilities": {
          "type": "object",
          "required": [
            "accountKinds",
            "signTransaction",
            "batch",
            "outcomeVerification",
            "signMessage",
            "signIn",
            "requestFunds"
          ],
          "properties": {
            "accountKinds": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "public"
                  },
                  {
                    "type": "string",
                    "const": "private"
                  }
                ]
              }
            },
            "signTransaction": {
              "type": "boolean"
            },
            "batch": {
              "type": "object",
              "required": ["maxInstructions", "atomic"],
              "properties": {
                "maxInstructions": {
                  "type": "integer",
                  "minimum": 1
                },
                "atomic": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "supported"
                    },
                    {
                      "type": "string",
                      "const": "unsupported"
                    }
                  ]
                }
              }
            },
            "proving": {
              "type": "object",
              "required": ["location"],
              "properties": {
                "location": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "local"
                    },
                    {
                      "type": "string",
                      "const": "paired"
                    },
                    {
                      "type": "string",
                      "const": "user-owned"
                    },
                    {
                      "type": "string",
                      "const": "tee"
                    }
                  ]
                },
                "typicalSeconds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "outcomeVerification": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "own-account-invariant"
                  },
                  {
                    "type": "string",
                    "const": "program-event"
                  },
                  {
                    "type": "string",
                    "const": "node"
                  }
                ]
              }
            },
            "signMessage": {
              "type": "boolean"
            },
            "signIn": {
              "type": "boolean"
            },
            "requestFunds": {
              "type": "boolean"
            }
          }
        },
        "signIn": {
          "type": "object",
          "required": ["account", "signedMessage", "signature"],
          "properties": {
            "account": {
              "type": "object",
              "required": ["address", "kind", "chain", "capabilities"],
              "properties": {
                "address": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                      "description": "Base58-encoded 32-byte LEZ account id"
                    },
                    {
                      "type": "string",
                      "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
                      "description": "Opaque per-origin private account handle"
                    }
                  ]
                },
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "public"
                    },
                    {
                      "type": "string",
                      "const": "private"
                    }
                  ]
                },
                "chain": {
                  "type": "string",
                  "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
                  "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
                },
                "publicKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 64
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "accounts"
                      },
                      {
                        "type": "string",
                        "const": "read_public"
                      },
                      {
                        "type": "string",
                        "const": "read_private"
                      },
                      {
                        "type": "string",
                        "const": "propose_tx"
                      },
                      {
                        "type": "string",
                        "const": "sign_message"
                      },
                      {
                        "type": "string",
                        "const": "request_proof"
                      }
                    ]
                  }
                }
              }
            },
            "signedMessage": {
              "type": "string"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          }
        }
      }
    },
    "SignInRequest": {
      "type": "object",
      "required": ["domain", "uri", "nonce", "issuedAt"],
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 253
        },
        "statement": {
          "type": "string",
          "maxLength": 512
        },
        "uri": {
          "type": "string",
          "maxLength": 2048
        },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expirationTime": {
          "type": "string",
          "format": "date-time"
        },
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "requestId": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "SignInResult": {
      "type": "object",
      "required": ["account", "signedMessage", "signature"],
      "properties": {
        "account": {
          "type": "object",
          "required": ["address", "kind", "chain", "capabilities"],
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                  "description": "Base58-encoded 32-byte LEZ account id"
                },
                {
                  "type": "string",
                  "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
                  "description": "Opaque per-origin private account handle"
                }
              ]
            },
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "public"
                },
                {
                  "type": "string",
                  "const": "private"
                }
              ]
            },
            "chain": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
              "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
            },
            "publicKey": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "label": {
              "type": "string",
              "maxLength": 64
            },
            "capabilities": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "accounts"
                  },
                  {
                    "type": "string",
                    "const": "read_public"
                  },
                  {
                    "type": "string",
                    "const": "read_private"
                  },
                  {
                    "type": "string",
                    "const": "propose_tx"
                  },
                  {
                    "type": "string",
                    "const": "sign_message"
                  },
                  {
                    "type": "string",
                    "const": "request_proof"
                  }
                ]
              }
            }
          }
        },
        "signedMessage": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      }
    },
    "WalletAccount": {
      "type": "object",
      "required": ["address", "kind", "chain", "capabilities"],
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
              "description": "Base58-encoded 32-byte LEZ account id"
            },
            {
              "type": "string",
              "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
              "description": "Opaque per-origin private account handle"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "public"
            },
            {
              "type": "string",
              "const": "private"
            }
          ]
        },
        "chain": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
          "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "label": {
          "type": "string",
          "maxLength": 64
        },
        "capabilities": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "accounts"
              },
              {
                "type": "string",
                "const": "read_public"
              },
              {
                "type": "string",
                "const": "read_private"
              },
              {
                "type": "string",
                "const": "propose_tx"
              },
              {
                "type": "string",
                "const": "sign_message"
              },
              {
                "type": "string",
                "const": "request_proof"
              }
            ]
          }
        }
      }
    },
    "AccountRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
          "description": "Base58-encoded 32-byte LEZ account id"
        },
        {
          "type": "string",
          "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
          "description": "Opaque per-origin private account handle"
        }
      ]
    },
    "Effect": {
      "type": "object",
      "required": ["account", "field"],
      "properties": {
        "account": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
              "description": "Base58-encoded 32-byte LEZ account id"
            },
            {
              "type": "string",
              "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
              "description": "Opaque per-origin private account handle"
            }
          ]
        },
        "field": {
          "anyOf": [
            {
              "type": "string",
              "const": "balance"
            },
            {
              "type": "string",
              "const": "token_balance"
            },
            {
              "type": "string",
              "const": "data"
            },
            {
              "type": "string",
              "const": "authority"
            },
            {
              "type": "string",
              "const": "nonce"
            }
          ]
        },
        "asset": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "FeeInfo": {
      "type": "object",
      "properties": {
        "estimatedMax": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,38})$",
          "description": "u128 as a decimal string"
        },
        "used": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,38})$",
          "description": "u128 as a decimal string"
        },
        "gasLimit": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "Instruction": {
      "type": "object",
      "required": ["program", "accounts", "data"],
      "properties": {
        "program": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
          "description": "Base58-encoded 32-byte LEZ account id"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["account", "writable", "signer"],
            "properties": {
              "account": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                    "description": "Base58-encoded 32-byte LEZ account id"
                  },
                  {
                    "type": "string",
                    "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
                    "description": "Opaque per-origin private account handle"
                  }
                ]
              },
              "writable": {
                "type": "boolean"
              },
              "signer": {
                "type": "boolean"
              }
            }
          }
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "display": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "maxLength": 64
            },
            "args": {
              "type": "object",
              "patternProperties": {
                "^.*$": {}
              }
            }
          }
        }
      }
    },
    "Lifecycle": {
      "anyOf": [
        {
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "type": "string",
          "const": "building"
        },
        {
          "type": "string",
          "const": "proving"
        },
        {
          "type": "string",
          "const": "signing"
        },
        {
          "type": "string",
          "const": "submitted"
        },
        {
          "type": "string",
          "const": "included"
        },
        {
          "type": "string",
          "const": "finalized"
        },
        {
          "type": "string",
          "const": "rejected"
        },
        {
          "type": "string",
          "const": "dropped"
        },
        {
          "type": "string",
          "const": "expired"
        }
      ]
    },
    "Outcome": {
      "anyOf": [
        {
          "type": "string",
          "const": "success"
        },
        {
          "type": "string",
          "const": "failure"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "OutcomeSource": {
      "anyOf": [
        {
          "type": "string",
          "const": "own-account-invariant"
        },
        {
          "type": "string",
          "const": "program-event"
        },
        {
          "type": "string",
          "const": "node"
        },
        {
