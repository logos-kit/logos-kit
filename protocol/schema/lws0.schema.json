{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos-kit.dev/schema/lws0.schema.json",
  "title": "LWS-0: Logos Kit wallet protocol",
  "version": "0.1.0",
  "$defs": {
    "AccountId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
      "description": "Base58-encoded 32-byte LEZ account id"
    },
    "AccountKind": {
      "anyOf": [
        {
          "type": "string",
          "const": "public"
        },
        {
          "type": "string",
          "const": "private"
        }
      ]
    },
    "Base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "maxLength": 65000
    },
    "ChainId": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
      "description": "CAIP-2 chain id, e.g. \"lez:testnet\""
    },
    "Hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "Hex": {
      "type": "string",
      "pattern": "^0x[0-9a-f]*$"
    },
    "PrivateHandle": {
      "type": "string",
      "pattern": "^pvt_[A-Za-z0-9_-]{16,64}$",
      "description": "Opaque per-origin private account handle"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "U128": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$",
      "description": "u128 as a decimal string. The pattern allows up to 39 digits; values above 2^128-1 are rejected by the codec and wallet with -32602."
    },
    "Capabilities": {
      "type": "object",
      "required": [
        "accountKinds",
        "signTransaction",
        "batch",
        "outcomeVerification",
        "signMessage",
        "signIn",
        "requestFunds"
      ],
      "properties": {
        "accountKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountKind"
          }
        },
        "signTransaction": {
          "type": "boolean"
        },
        "batch": {
          "type": "object",
          "required": ["maxInstructions", "atomic"],
          "properties": {
            "maxInstructions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "atomic": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "supported"
                },
                {
                  "type": "string",
                  "const": "unsupported"
                }
              ]
            }
          }
        },
        "proving": {
          "type": "object",
          "required": ["location"],
          "properties": {
            "location": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "local"
                },
                {
                  "type": "string",
                  "const": "paired"
                },
                {
                  "type": "string",
                  "const": "user-owned"
                },
                {
                  "type": "string",
                  "const": "tee"
                }
              ]
            },
            "typicalSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "outcomeVerification": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "own-account-invariant"
              },
              {
                "type": "string",
                "const": "program-event"
              },
              {
                "type": "string",
                "const": "node"
              }
            ]
          }
        },
        "signMessage": {
          "type": "boolean"
        },
        "signIn": {
          "type": "boolean"
        },
        "requestFunds": {
          "type": "boolean"
        }
      }
    },
    "Capability": {
      "anyOf": [
        {
          "type": "string",
          "const": "accounts"
        },
        {
          "type": "string",
          "const": "read_public"
        },
        {
          "type": "string",
          "const": "read_private"
        },
        {
          "type": "string",
          "const": "propose_tx"
        },
        {
          "type": "string",
          "const": "sign_message"
        },
        {
          "type": "string",
          "const": "request_proof"
        }
      ]
    },
    "ConnectParams": {
      "type": "object",
      "required": ["chains"],
      "properties": {
        "chains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChainId"
          },
          "minItems": 1
        },
        "accountKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountKind"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "silent": {
          "type": "boolean"
        },
        "signIn": {
          "$ref": "#/$defs/SignInRequest"
        }
      }
    },
    "Session": {
      "type": "object",
      "required": ["sessionId", "origin", "chains", "accounts", "capabilities"],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "origin": {
          "type": "string"
        },
        "chains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChainId"
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WalletAccount"
          }
        },
        "expiry": {
          "$ref": "#/$defs/Timestamp"
        },
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
        },
        "signIn": {
          "$ref": "#/$defs/SignInResult"
        }
      }
    },
    "SignInRequest": {
      "type": "object",
      "required": ["domain", "uri", "nonce", "issuedAt"],
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 253
        },
        "statement": {
          "type": "string",
          "maxLength": 512
        },
        "uri": {
          "type": "string",
          "maxLength": 2048
        },
        "nonce": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "issuedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "expirationTime": {
          "$ref": "#/$defs/Timestamp"
        },
        "notBefore": {
          "$ref": "#/$defs/Timestamp"
        },
        "requestId": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "SignInResult": {
      "type": "object",
      "required": ["account", "signedMessage", "signature"],
      "properties": {
        "account": {
          "$ref": "#/$defs/WalletAccount"
        },
        "signedMessage": {
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/Base64"
        }
      }
    },
    "WalletAccount": {
      "type": "object",
      "required": ["address", "kind", "chain", "capabilities"],
      "properties": {
        "address": {
          "$ref": "#/$defs/AccountRef"
        },
        "kind": {
          "$ref": "#/$defs/AccountKind"
        },
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "publicKey": {
          "$ref": "#/$defs/Base64"
        },
        "label": {
          "type": "string",
          "maxLength": 64
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        }
      }
    },
    "AccountRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccountId"
        },
        {
          "$ref": "#/$defs/PrivateHandle"
        }
      ]
    },
    "Effect": {
      "type": "object",
      "required": ["account", "field"],
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "field": {
          "anyOf": [
            {
              "type": "string",
              "const": "balance"
            },
            {
              "type": "string",
              "const": "token_balance"
            },
            {
              "type": "string",
              "const": "data"
            },
            {
              "type": "string",
              "const": "authority"
            },
            {
              "type": "string",
              "const": "nonce"
            }
          ]
        },
        "asset": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "FeeInfo": {
      "type": "object",
      "properties": {
        "estimatedMax": {
          "$ref": "#/$defs/U128"
        },
        "used": {
          "$ref": "#/$defs/U128"
        },
        "gasLimit": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "Instruction": {
      "type": "object",
      "required": ["program", "accounts", "data"],
      "properties": {
        "program": {
          "$ref": "#/$defs/AccountId"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["account", "writable", "signer"],
            "properties": {
              "account": {
                "$ref": "#/$defs/AccountRef"
              },
              "writable": {
                "type": "boolean"
              },
              "signer": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 64
        },
        "data": {
          "$ref": "#/$defs/Base64"
        },
        "display": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "maxLength": 64
            },
            "args": {
              "type": "object",
              "patternProperties": {
                "^.*$": {}
              }
            }
          }
        }
      }
    },
    "Lifecycle": {
      "anyOf": [
        {
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "type": "string",
          "const": "building"
        },
        {
          "type": "string",
          "const": "proving"
        },
        {
          "type": "string",
          "const": "signing"
        },
        {
          "type": "string",
          "const": "submitted"
        },
        {
          "type": "string",
          "const": "included"
        },
        {
          "type": "string",
          "const": "finalized"
        },
        {
          "type": "string",
          "const": "rejected"
        },
        {
          "type": "string",
          "const": "dropped"
        },
        {
          "type": "string",
          "const": "expired"
        }
      ]
    },
    "Outcome": {
      "anyOf": [
        {
          "type": "string",
          "const": "success"
        },
        {
          "type": "string",
          "const": "failure"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "OutcomeSource": {
      "anyOf": [
        {
          "type": "string",
          "const": "own-account-invariant"
        },
        {
          "type": "string",
          "const": "program-event"
        },
        {
          "type": "string",
          "const": "node"
        },
        {
          "type": "string",
          "const": "none"
        }
      ]
    },
    "SubmitResult": {
      "type": "object",
      "required": ["handle"],
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "txHash": {
          "$ref": "#/$defs/Hash32"
        }
      }
    },
    "TransactionProposal": {
      "type": "object",
      "required": ["chain", "account", "instructions"],
      "properties": {
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Instruction"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "atomicRequired": {
          "type": "boolean"
        }
      }
    },
    "TransactionStatus": {
      "type": "object",
      "required": ["handle", "chain", "lifecycle", "outcome", "outcomeSource"],
      "properties": {
        "handle": {
          "type": "string"
        },
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "txHash": {
          "$ref": "#/$defs/Hash32"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "outcomeSource": {
          "$ref": "#/$defs/OutcomeSource"
        },
        "block": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "timestamp": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        "expectedEffects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "observedEffects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Effect"
          }
        },
        "fee": {
          "$ref": "#/$defs/FeeInfo"
        },
        "proving": {
          "type": "object",
          "required": ["phase"],
          "properties": {
            "phase": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "preparing"
                },
                {
                  "type": "string",
                  "const": "proving"
                },
                {
                  "type": "string",
                  "const": "submitting"
                },
                {
                  "type": "string",
                  "const": "waiting_for_block"
                }
              ]
            },
            "progress": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "etaSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "startedAt": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {}
          }
        }
      }
    },
    "BalanceParams": {
      "type": "object",
      "required": ["chain", "account"],
      "properties": {
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        },
        "asset": {
          "$ref": "#/$defs/AccountId"
        }
      }
    },
    "BalanceResult": {
      "type": "object",
      "required": ["asset", "amount", "synced"],
      "properties": {
        "asset": {
          "anyOf": [
            {
              "type": "string",
              "const": "native"
            },
            {
              "$ref": "#/$defs/AccountId"
            }
          ]
        },
        "amount": {
          "$ref": "#/$defs/U128"
        },
        "synced": {
          "type": "boolean"
        },
        "asOfBlock": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "OpenExplorerParams": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "txHash": {
          "$ref": "#/$defs/Hash32"
        },
        "account": {
          "$ref": "#/$defs/AccountId"
        }
      }
    },
    "OpenExplorerResult": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "ReadAccountParams": {
      "type": "object",
      "required": ["chain", "account", "program"],
      "properties": {
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "account": {
          "$ref": "#/$defs/AccountId"
        },
        "program": {
          "$ref": "#/$defs/AccountId"
        }
      }
    },
    "ReadAccountResult": {
      "type": "object",
      "required": ["nonce", "data"],
      "properties": {
        "nonce": {
          "$ref": "#/$defs/U128"
        },
        "data": {
          "$ref": "#/$defs/Base64"
        }
      }
    },
    "RequestFundsParams": {
      "type": "object",
      "required": ["chain", "account"],
      "properties": {
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        }
      }
    },
    "RequestFundsResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "funded"
            },
            {
              "type": "string",
              "const": "rate_limited"
            },
            {
              "type": "string",
              "const": "rejected"
            },
            {
              "type": "string",
              "const": "outcome_unknown"
            }
          ]
        },
        "amount": {
          "$ref": "#/$defs/U128"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "txHash": {
          "$ref": "#/$defs/Hash32"
        },
        "shieldHandle": {
          "type": "string"
        },
        "fundedAccount": {
          "$ref": "#/$defs/AccountId"
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "SignMessageParams": {
      "type": "object",
      "required": ["account", "message"],
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountId"
        },
        "message": {
          "$ref": "#/$defs/Base64"
        }
      }
    },
    "SignMessageResult": {
      "type": "object",
      "required": ["signature", "publicKey", "tag"],
      "properties": {
        "signature": {
          "$ref": "#/$defs/Base64"
        },
        "publicKey": {
          "$ref": "#/$defs/Base64"
        },
        "tag": {
          "type": "string",
          "const": "LEZ/message/v1"
        }
      }
    },
    "TokenEntry": {
      "type": "object",
      "required": ["definition", "amount", "tier"],
      "properties": {
        "definition": {
          "$ref": "#/$defs/AccountId"
        },
        "name": {
          "type": "string",
          "maxLength": 64
        },
        "symbol": {
          "type": "string",
          "maxLength": 11
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "amount": {
          "$ref": "#/$defs/U128"
        },
        "tier": {
          "$ref": "#/$defs/TokenTier"
        }
      }
    },
    "TokenTier": {
      "anyOf": [
        {
          "type": "string",
          "const": "verified"
        },
        {
          "type": "string",
          "const": "added"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "TokensParams": {
      "type": "object",
      "required": ["chain", "account"],
      "properties": {
        "chain": {
          "$ref": "#/$defs/ChainId"
        },
        "account": {
          "$ref": "#/$defs/AccountRef"
        }
      }
    },
    "TokensResult": {
      "type": "object",
      "required": ["tokens", "synced"],
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenEntry"
          }
        },
        "synced": {
          "type": "boolean"
        }
      }
    }
  }
}
