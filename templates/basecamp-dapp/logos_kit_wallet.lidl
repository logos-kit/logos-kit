module logos_kit_wallet {
  version "0.1.2"
  description "Logos Kit wallet engine for the Logos Execution Zone: keys, accounts, approvals, proving"

  method ping() -> tstr description "Health check."
  method whoami() -> tstr description "The caller identity as this module sees it."
  method engine_info() -> tstr description "Engine build info (proves the LEZ engine is linked)."

  method lez_connect(params: tstr) -> any description "LWS-0 connect (silent restore only; use the lez.wallet.connect intent)."
  method lez_disconnect(params: tstr) -> any description "LWS-0: drop this app's grants."
  method lez_getSession(params: tstr) -> any description "LWS-0: this app's session, or null."
  method lez_getAccounts(params: tstr) -> any description "LWS-0: accounts shared with this app."
  method lez_getCapabilities(params: tstr) -> any description "LWS-0: what this wallet supports."
  method lez_getBalance(params: tstr) -> any description "LWS-0: balance of a shared account."
  method lez_readAccount(params: tstr) -> any description "LWS-0: a public account's data for one program (chain state)."
  method lez_chainId(params: tstr) -> any description "LWS-0: the network the wallet is on ({chain})."
  method lez_openExplorer(params: tstr) -> any description "LWS-0: open the zone's explorer at a transaction or account (the wallet builds the URL)."
  method lez_signAndSendTransaction(params: tstr) -> any description "LWS-0: propose a transaction for the user's approval; answers a handle."
  method lez_getTransactionStatus(params: tstr) -> any description "LWS-0: status of this app's request."
  method lez_signMessage(params: tstr) -> any description "LWS-0 (needs the lez.message.sign intent)."
  method lez_signIn(params: tstr) -> any description "LWS-0 (needs the lez.wallet.sign_in intent)."
  method lez_requestFunds(params: tstr) -> any description "LWS-0 (needs the lez.wallet.request_funds intent)."
  method lez_switchChain(params: tstr) -> any description "LWS-0 (needs the wallet UI)."

  method ui(method: tstr, params: tstr) -> any description "The wallet UI's own API (ui_state, ui_approve, ...). Answers logos_kit_wallet_ui only."

  event request_updated(handle: tstr) description "A request changed; read it with lez_getTransactionStatus."
  event wallet_event(kind: tstr, payload: tstr) description "Wallet-level change (wallet_changed, snapshot_updated, funds_updated). No private data."
}
