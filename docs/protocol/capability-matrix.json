  "fakeScenarios": [
    {
      "name": "happy",
      "description": "Connect shares one public account (and a private handle if asked). Balance 1000000000. A send answers a handle; status reads go submitted \u2192 included/success. The faucet funds 1000000000."
    },
    {
      "name": "reject",
      "description": "The user declines every wallet prompt: each intent answers `cancelled` (LWS-0 4001)."
    },
    {
      "name": "timeout",
      "description": "Like happy, but the send intent answers only after 50 s: the SDK times out at 45 s (6108) and the handle arrives late (`onLateResult`)."
    },
    {
      "name": "stale",
      "description": "The send is approved, then the chain moved: status goes signing \u2192 dropped with error 6106 (StaleApproval). Nothing was sent."
    },
    {
      "name": "unknown_outcome",
      "description": "The send is included but the wallet can't tell whether it worked: included, outcome `unknown`, outcomeSource `none`."
    },
    {
      "name": "failed_onchain",
      "description": "The send is included and failed on chain: included, outcome `failure` (own-account-invariant)."
    },
    {
      "name": "rate_limited",
      "description": "Balance 0. The faucet refuses: `rate_limited`, retryAfterSeconds 60. Everything else is happy."
    },
    {
      "name": "faucet_unknown",
      "description": "Balance 0. The faucet answer is lost: `outcome_unknown`. The funds do arrive (balance +1000000000), so a dApp that re-reads the balance finds them."
    },
    {
      "name": "no_funds",
      "description": "Balance 0. A send is refused by the wallet (intent answers `failed`, as in every scenario while the account is empty); the faucet funds 1000000000, after which sends work."
    },
    {
      "name": "network_switch",
      "description": "After the first connect, the user switches the wallet to lez:local: the next lez_chainId answers lez:local, the old session is gone and calls naming the old chain get 4902."
    },
    {
      "name": "unavailable",
      "description": "The wallet is not running: every method answers 6109, every intent `unavailable`."
    }
