{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/CHANGELOG.md",
      "!**/pnpm-lock.yaml",
      "!**/dist",
      "!sdk/qml/**/logoskit.js",
      "!sdk/qml/**/Tokens.js",
      "!modules/*/qml",
      "!templates/*/qml/LogosKit",
      "!templates/*/qml/LogosKitUi",
      "!packages/qml-bundle/src/qml-shims.js",
      "!packages/qml-bundle/babel-plugin-qml-v4.cjs",
      "!packages/qml-bundle/gate/noderun.cjs",
      "!docs/dev/PLAN.md",
      "!assets/logos",
      "!sdk/qml/LogosKitUi/assets",
      "!protocol/vectors",
      "!docs/protocol/capability-matrix.json",
      "!docs/design/*.html",
      "!apps/design-lab/src/components/ui",
      "!apps/design-lab/src/hooks"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "protocol/src/**",
        "packages/codec/src/**",
        "packages/client/src/**",
        "packages/core/src/**",
        "packages/theme/src/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useOptionalChain": "off"
          },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "BigInt": "QML-safe package: use decimal strings + bn.js (see AGENTS.md)",
                  "Intl": "QML-safe package: Intl is unavailable in Qt's V4 engine"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "protocol/src/**",
        "packages/codec/src/**",
        "packages/client/src/**",
        "packages/theme/src/**",
        "packages/qml-bundle/src/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noPrototypeBuiltins": "off"
          }
        }
      }
    }
  ]
}
