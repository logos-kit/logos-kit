{
  "name": "@logos-kit/client",
  "version": "0.1.0",
  "description": "Typed client for the Logos Execution Zone: node reads, LWS-0 wallet actions, lossless u128 JSON. QML-safe root; raw-key signing in ./local.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logos-kit/logos-kit.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.qml.json",
    "check:qml": "node ../../scripts/check-es2017.ts dist local.js",
    "test": "vitest run",
    "test:build": "publint --strict && attw --pack --profile esm-only"
  },
  "dependencies": {
    "@logos-kit/codec": "workspace:*",
    "@logos-kit/protocol": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "logos",
    "lez",
    "logos-execution-zone",
    "wallet",
    "client",
    "basecamp",
    "dapp"
  ],
  "homepage": "https://logos-kit-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/logos-kit/logos-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
